{
  "name": "hostel-and-pg-finder",
  "version": "1.0.0",
  "description": "Hostel and PG Finder - Full-Stack MERN Application",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "build:client": "npm run build --prefix client",
    "test:server": "npm test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "mern",
    "hostel",
    "pg-finder",
    "react",
    "express",
    "mongodb",
    "node"
  ],
  "author": "purush",
  "license": "ISC"
}

